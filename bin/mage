#!/usr/bin/env python3
"""mage — OSS CrossOver alternative for Apple silicon. 0.1 alpha CLI."""
import argparse
import json
import os
import re
import signal
import subprocess
import sys
import tarfile
import tempfile
import time
from pathlib import Path

MAGE_DIR = Path(__file__).resolve().parent.parent
RECIPES_DIR = MAGE_DIR / "recipes"
RUNTIMES_DIR = MAGE_DIR / "runtimes"
PREFIXES_DIR = MAGE_DIR / "prefixes"
DIAG_DIR = MAGE_DIR / "docs" / "testing" / "diagnostics"
MARKER = ".mage-bottle.json"


def die(msg, code=1):
    print(f"mage: error: {msg}", file=sys.stderr)
    sys.exit(code)


def load_json(path):
    try:
        with open(path) as f:
            return json.load(f)
    except FileNotFoundError:
        die(f"not found: {path}")
    except json.JSONDecodeError as e:
        die(f"invalid json in {path}: {e}")


def load_recipe(rid):
    return load_json(RECIPES_DIR / f"{rid}.json")


def load_runtime(rid):
    rt = load_json(RUNTIMES_DIR / f"{rid}.json")
    root = Path(rt["root"])
    if not root.is_absolute():
        root = (MAGE_DIR / root).resolve()
    rt["root"] = root
    if not (root / rt["wine"]).exists():
        die(f"runtime {rid}: {root / rt['wine']} does not exist")
    if "vulkan_library_path" in rt:
        vulkan_library_path = (MAGE_DIR / rt["vulkan_library_path"]).resolve()
        if not vulkan_library_path.is_dir() or not (vulkan_library_path / "libvulkan.1.dylib").is_file():
            die(f"runtime {rid}: {vulkan_library_path} does not contain libvulkan.1.dylib")
        rt["vulkan_library_path"] = str(vulkan_library_path)
    return rt


def marker_path(prefix):
    return Path(prefix) / MARKER


def find_bottle(name):
    """Bottle by name: mage-managed prefix, or any marker referencing it."""
    for marker in [PREFIXES_DIR / name / MARKER]:
        if marker.exists():
            m = load_json(marker)
            return m, marker.parent
    # search imported bottles (marker holds name); scan known locations
    for marker in PREFIXES_DIR.glob(f"*/{MARKER}"):
        m = load_json(marker)
        if m.get("name") == name:
            return m, marker.parent
    # imported prefixes live outside mage/: record them in a registry file
    reg = MAGE_DIR / "prefixes" / "imported.json"
    if reg.exists():
        for entry in load_json(reg):
            if entry.get("name") == name:
                return entry, Path(entry["prefix"])
    die(f"no bottle named '{name}' (see: mage list)")


def register_import(name, prefix, recipe_id):
    reg = PREFIXES_DIR / "imported.json"
    entries = load_json(reg) if reg.exists() else []
    entries = [e for e in entries if e.get("name") != name]
    entries.append({"name": name, "recipe": recipe_id, "prefix": str(prefix)})
    PREFIXES_DIR.mkdir(exist_ok=True)
    with open(reg, "w") as f:
        json.dump(entries, f, indent=2)


def run_env(recipe, runtime, prefix):
    env = dict(os.environ)
    env.update(recipe.get("env", {}))
    env["WINEPREFIX"] = str(prefix)
    env["CX_REPORT_REAL_USERNAME"] = "1"
    env["DYLD_FALLBACK_LIBRARY_PATH"] = str(runtime["root"] / "lib")
    # Never let games switch the physical display mode: on Apple Silicon the
    # capture+mode-switch path yields a black shielded screen. The game
    # renders at its chosen resolution into its window and the compositor
    # scales it (CrossOver/GPTK behavior). winemac patch, universal default.
    env.setdefault("MAGE_FAKE_DISPLAY_MODES", "1")
    # Games launched from a detached session must be allowed to take focus
    # (macOS focus-steal prevention otherwise strands them behind the
    # terminal; idTech idles at loading until focused). winemac patch.
    env.setdefault("MAGE_FORCE_ACTIVATION", "1")
    # Steam games launched directly (bypassing applaunch) need these or
    # steam_api(64).dll calls RestartAppIfNecessary and the exe exits at once.
    appid = recipe.get("steam_appid")
    if appid:
        env.setdefault("SteamAppId", str(appid))
        env.setdefault("SteamGameId", str(appid))
    # MoltenVK selection: a recipe-level path wins over the runtime default,
    # so Advanced settings can pin a game to a specific MageVK build.
    vulkan_library_path = recipe.get("vulkan_library_path") or runtime.get("vulkan_library_path")
    if vulkan_library_path:
        p = Path(vulkan_library_path)
        if not p.is_absolute():
            p = (MAGE_DIR / p).resolve()
        if not p.is_dir() or not ((p / "libvulkan.1.dylib").is_file()
                                  or (p / "libMoltenVK.dylib").is_file()):
            die(f"vulkan library path {p} contains neither "
                "libvulkan.1.dylib nor libMoltenVK.dylib")
        env["DYLD_LIBRARY_PATH"] = str(p)
    return env


def configure_prefix(recipe, runtime, prefix):
    wine = str(runtime["root"] / runtime["wine"])
    env = run_env(recipe, runtime, prefix)
    key = r"HKCU\Software\Wine\X11 Driver"
    query = subprocess.run([wine, "reg", "query", key, "/v", "EmulateModeset"],
                           env=env, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
    if query.returncode:
        result = subprocess.run([wine, "reg", "add", key, "/v", "EmulateModeset", "/t", "REG_SZ",
                                 "/d", "Y", "/f"], env=env)
        if result.returncode:
            die(f"prefix configuration failed ({result.returncode})")


def cmd_list(_args):
    print("recipes:")
    for r in sorted(RECIPES_DIR.glob("*.json")):
        j = load_json(r)
        print(f"  {j['id']:<16} {j.get('title', '')}")
    print("bottles:")
    found = False
    for marker in sorted(PREFIXES_DIR.glob(f"*/{MARKER}")):
        m = load_json(marker)
        print(f"  {m['name']:<16} recipe={m['recipe']}  prefix={marker.parent}")
        found = True
    reg = PREFIXES_DIR / "imported.json"
    if reg.exists():
        for e in load_json(reg):
            print(f"  {e['name']:<16} recipe={e['recipe']}  prefix={e['prefix']} (imported)")
            found = True
    if not found:
        print("  (none)")


def cmd_install(args):
    recipe = load_recipe(args.recipe)
    runtime = load_runtime(recipe["runtime"])
    name = args.name or recipe["id"]
    if args.import_prefix:
        prefix = Path(args.import_prefix).resolve()
        if not prefix.is_dir():
            die(f"--import-prefix {prefix} is not a directory")
        register_import(name, prefix, recipe["id"])
        print(f"imported {prefix} as bottle '{name}'")
    else:
        prefix = PREFIXES_DIR / name
        prefix.mkdir(parents=True, exist_ok=True)
        env = run_env(recipe, runtime, prefix)
        print(f"initializing prefix {prefix} (wineboot)...")
        r = subprocess.run([str(runtime["root"] / runtime["wine"]), "wineboot", "--init"], env=env)
        if r.returncode != 0:
            die(f"wineboot failed ({r.returncode})")
    configure_prefix(recipe, runtime, prefix)
    marker = {"name": name, "recipe": recipe["id"], "prefix": str(prefix),
              "created": time.strftime("%Y-%m-%dT%H:%M:%S")}
    with open(marker_path(prefix), "w") as f:
        json.dump(marker, f, indent=2)
    warns = file_checks(recipe, prefix)
    for w in warns:
        print(f"  warning: {w}")
    print(f"bottle '{name}' ready")


def file_checks(recipe, prefix):
    warns = []
    for chk in recipe.get("file_checks", []):
        if not (Path(prefix) / chk["path"]).exists():
            warns.append(f"missing {chk['path']} — {chk.get('hint', '')}")
    return warns


WRAPPER_MARKER = b"MAGE-STEAMWEBHELPER-WRAPPER"


def ensure_steam_wrapper(prefix):
    """Install/lock the single-process steamwebhelper wrapper if the prefix
    has Steam and the wrapper is missing, outdated, or unlocked. Idempotent.
    Steam self-heals the real exe over the wrapper otherwise (uchg lock), and
    Steam client updates replace the binary outright (re-installed here).

    Marker-based: a file containing WRAPPER_MARKER is one of our wrapper
    builds, never Valve's binary. Only genuine Valve binaries may be backed
    up as steamwebhelper_real.exe — backing up a wrapper there makes the
    wrapper exec itself in a fork loop (incident 2026-07-28)."""
    import stat as statmod
    cef = Path(prefix) / "drive_c/Program Files (x86)/Steam/bin/cef/cef.win64"
    target = cef / "steamwebhelper.exe"
    real = cef / "steamwebhelper_real.exe"
    wrapper = MAGE_DIR / "tools" / "steamwebhelper-wrapper" / "steamwebhelper.exe"
    if not target.is_file() or not wrapper.is_file():
        return
    wbytes = wrapper.read_bytes()
    tbytes = target.read_bytes()
    target_is_wrapper = WRAPPER_MARKER in tbytes
    if real.is_file() and WRAPPER_MARKER in real.read_bytes():
        # corrupted backup (would fork-loop) — quarantine it
        quarantine = cef / "steamwebhelper_real.CORRUPT-do-not-use.exe"
        quarantine.unlink(missing_ok=True)
        real.rename(quarantine)
        print("mage: warning: steamwebhelper_real.exe was a wrapper build "
              "(would crash-loop); quarantined", file=sys.stderr)
    if tbytes != wbytes:
        subprocess.run(["chflags", "nouchg", str(target)],
                       stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
        if not target_is_wrapper and not real.is_file():
            real.write_bytes(tbytes)  # genuine Valve binary — keep exactly once
        target.write_bytes(wbytes)
        print("mage: steamwebhelper wrapper (re)installed")
    flags = os.stat(target).st_flags
    if not (flags & statmod.UF_IMMUTABLE):
        subprocess.run(["chflags", "uchg", str(target)],
                       stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
        print("mage: steamwebhelper wrapper locked (uchg)")


def ensure_app_launcher(runtime, name, display=None):
    """Create/update a copy of the wine loader named after the app (patched
    embedded Info.plist) so the Dock/menu bar show e.g. "Steam" not "Wine".
    mage-wine's ntdll execs it when MAGE_APP_NAME is set. Idempotent.
    `display` overrides the Dock name when it differs from the loader name
    (ntdll derives the loader name from the exe basename)."""
    tool = MAGE_DIR / "tools" / "wine-app-name" / "patch-wine-loader-name.py"
    if not tool.is_file():
        return
    cmd = [sys.executable, str(tool), str(runtime["root"]), name]
    if display and display != name:
        bundleid = 'app.mage.' + ''.join(
            c.lower() if c.isalnum() else '-' for c in name).strip('-')
        cmd += [bundleid, display]
    subprocess.run(cmd, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)


def app_name_for(program):
    """'C:\\Program Files (x86)\\Steam\\steam.exe' -> 'Steam'"""
    base = exe_basename(program)
    if base.lower().endswith(".exe"):
        base = base[:-4]
    return base[:1].upper() + base[1:] if base else "Wine"


def exe_basename(program):
    """'C:\\Program Files (x86)\\Steam\\steam.exe' -> 'steam.exe'"""
    return program.replace("\\", "/").rsplit("/", 1)[-1]


def app_exes_for(step):
    """Exes that get named sibling loaders for a launch step (Dock identity).
    Defaults to the step's program; a recipe may widen it with "app_exes"
    (the program's basename is always included)."""
    exes = [exe_basename(step["program"])]
    for extra in step.get("app_exes", []):
        if extra.lower() not in {e.lower() for e in exes}:
            exes.append(extra)
    return ":".join(exes)


def app_exes_union(recipe):
    """Recipe-wide named-loader exe list: every launch step's list, merged.
    A game re-spawned by a helper from an earlier step (Steam's steam://
    handoff) inherits that step's env, so every step must name-load every
    app exe."""
    seen = []
    for st in recipe.get("launch", []):
        for exe in app_exes_for(st).split(":"):
            if exe.lower() not in {e.lower() for e in seen}:
                seen.append(exe)
    return ":".join(seen)


STEAM_UI_EXES = ("steamwebhelper.exe", "steamwebhelper_real.exe")

# Known orchestrators/helpers that must never become a foreground macOS app.
# Everything else defaults to foreground (denylist gating): any game exe
# gets its own Dock presence with zero per-game recipe config, and a missing
# recipe entry can never produce a headless uncloseable window.
BACKGROUND_EXES = (
    # steam orchestration
    "steam.exe", "steamservice.exe", "steamerrorreporter.exe",
    "steamerrorreporter64.exe", "steamsysinfo.exe", "hardwareupdater.exe",
    "gldriverquery.exe", "gldriverquery64.exe", "vulkandriverquery.exe",
    "vulkandriverquery64.exe", "steam_monitor.exe", "steambootstrapper.exe",
    "streaming_client.exe", "gameoverlayui.exe",
    # wine/system plumbing
    "conhost.exe", "explorer.exe", "services.exe", "svchost.exe",
    "rpcss.exe", "plugplay.exe", "winedevice.exe", "wineboot.exe",
    "rundll32.exe", "msiexec.exe", "regsvr32.exe", "tabtip.exe",
    "winemenubuilder.exe", "winecfg.exe", "control.exe", "notepad.exe",
)


def session_app_exes(all_exes):
    """Exe basenames that get named sibling loaders (Dock identity).
    steam.exe itself is a windowless orchestrator; the Steam UI lives in
    steamwebhelper_real.exe (single-process CEF wrapper) and shows as
    'Steam'. Gating itself is denylist-based (BACKGROUND_EXES), so this
    list is only about WHICH exes get a prepared named loader."""
    out = []
    for exe in all_exes.split(":"):
        if exe.lower() == "steam.exe":
            candidates = STEAM_UI_EXES
        else:
            candidates = (exe,)
        for e in candidates:
            if e and e.lower() not in {x.lower() for x in out}:
                out.append(e)
    return ":".join(out)


def exe_cwd(prefix, program):
    """Unix path of the exe's directory (C:\\... -> prefix/drive_c/...).
    Games expect their working directory next to the exe; without it some
    die on asset lookup (DOOM 2016: C++ exception e06d7363 right after
    Steam API init)."""
    p = program.replace("\\", "/")
    if len(p) > 2 and p[1] == ":":
        return str((prefix / "drive_c" / p[2:].lstrip("/")).parent)
    return None


def cmd_run(args):
    meta, prefix = find_bottle(args.name)
    recipe = load_recipe(meta["recipe"])
    runtime = load_runtime(recipe["runtime"])
    env = run_env(recipe, runtime, prefix)
    wine = str(runtime["root"] / runtime["wine"])
    log = Path(tempfile.gettempdir()) / f"mage-{args.name}.log"

    steps = []
    all_exes = app_exes_union(recipe)
    session_exes = session_app_exes(all_exes)
    for st in recipe.get("launch", []):
        app = app_name_for(st["program"])
        ensure_app_launcher(runtime, app)
        steps.append((app, [wine, st["program"]] + st.get("args", [])))
    # named loaders for every allowlisted exe (the loader derives the Dock
    # name from the exe itself when a helper re-spawns the game)
    for exe in session_exes.split(":"):
        if exe:
            ensure_app_launcher(runtime, app_name_for(exe))
    # the Steam UI process shows as "Steam", not "Steamwebhelper_real"
    if "steamwebhelper_real.exe" in session_exes.lower():
        ensure_app_launcher(runtime, "Steamwebhelper_real", display="Steam")

    if args.dry_run:
        print(f"log: {log}")
        for k in sorted(env):
            if k.startswith(("WINE", "ROSETTA", "MTL", "MVK", "DYLD")):
                print(f"env {k}={env[k]}")
        for st, (app, s) in zip(recipe.get("launch", []), steps):
            print(f"env MAGE_APP_NAME={app}")
            print(f"env MAGE_BACKGROUND_EXE={':'.join(BACKGROUND_EXES)}")
            print("run " + " ".join(s))
        return

    configure_prefix(recipe, runtime, prefix)
    ensure_steam_wrapper(prefix)
    for w in file_checks(recipe, prefix):
        print(f"mage: warning: {w}", file=sys.stderr)
    lf = open(log, "w")
    for st, (app, cmd) in zip(recipe.get("launch", []), steps):
        step_env = dict(env, MAGE_APP_NAME=app,
                        MAGE_BACKGROUND_EXE=":".join(BACKGROUND_EXES))
        cwd = exe_cwd(prefix, st["program"])
        print(f"mage: {' '.join([cmd[1]] + st.get('args', []))}")
        if st.get("background", True):
            subprocess.Popen(cmd, env=step_env, stdout=lf, stderr=subprocess.STDOUT,
                             cwd=cwd, start_new_session=True)
        else:
            subprocess.run(cmd, env=step_env, stdout=lf, stderr=subprocess.STDOUT,
                           cwd=cwd)
        wait = st.get("then_wait", 0)
        if wait:
            print(f"mage: waiting {wait}s")
            time.sleep(wait)
    print(f"mage: launched '{args.name}' (log: {log})")


STEAM_EXE = r"C:\Program Files (x86)\Steam\steam.exe"
STEAM_SILENT_ARGS = ["-silent", "-nobootstrapupdate", "-skipinitialbootstrap",
                     "-noverifyfiles", "-cef-disable-gpu", "-cef-disable-gpu-compositing"]


def steam_root(prefix):
    return Path(prefix) / "drive_c/Program Files (x86)/Steam"


def steam_client_pid(recipe, runtime, prefix):
    """PID of the running Steam client from its ActiveProcess registry key;
    0 when no client is up. Cheap probe that avoids pgrep false positives."""
    env = run_env(recipe, runtime, prefix)
    wine = str(runtime["root"] / runtime["wine"])
    r = subprocess.run([wine, "reg", "query",
                        r"HKCU\Software\Valve\Steam\ActiveProcess", "/v", "pid"],
                       env=env, stdout=subprocess.PIPE, stderr=subprocess.DEVNULL,
                       text=True, timeout=30)
    m = re.search(r"\bpid\s+REG_DWORD\s+(0x[0-9a-fA-F]+|\d+)", r.stdout)
    return int(m.group(1), 0) if m else 0


def acf_state_flags(path):
    try:
        text = path.read_text(errors="replace")
    except OSError:
        return None
    m = re.search(r'"StateFlags"\s+"(\d+)"', text)
    return int(m.group(1)) if m else None


def steam_logged_in(prefix):
    """True once the client holds a real account session. A client that is
    still booting — or stuck applying its own self-update — sits at
    SetSteamID [U:1:0] and silently drops forwarded commands, so this is
    the gate before +app_install. Reads connection_log.txt, no probing."""
    log = steam_root(prefix) / "logs/connection_log.txt"
    try:
        lines = log.read_text(errors="replace").splitlines()
    except OSError:
        return False
    for line in reversed(lines[-400:]):
        if "SetSteamID" in line:
            # [U:1:<accountid>] — 0 means anonymous / not logged on.
            m = re.search(r"SetSteamID\( \[U:1:(\d+)\] \)", line)
            return bool(m and m.group(1) != "0")
    return False


def dir_size_bytes(path):
    if not path.is_dir():
        return 0
    r = subprocess.run(["du", "-sk", str(path)], stdout=subprocess.PIPE,
                       stderr=subprocess.DEVNULL, text=True)
    if r.returncode != 0:
        return 0
    return int(r.stdout.split("\t")[0].strip()) * 1024


def install_snapshot(prefix, appid):
    apps = steam_root(prefix) / "steamapps"
    flags = acf_state_flags(apps / f"appmanifest_{appid}.acf")
    downloaded = dir_size_bytes(apps / "downloading" / str(appid))
    # StateFlags 4 = fully installed; anything else means work in flight.
    return {"status": "ok", "appid": str(appid), "state_flags": flags,
            "bytes_downloaded": downloaded, "installed": flags == 4}


def cmd_steam_install(args):
    """Install an owned game without ever showing a Steam window: ensure a
    -silent Steam client is up in the bottle, forward +app_install to it, and
    report progress as JSON lines while the manifest settles."""
    meta, prefix = find_bottle(args.bottle)
    recipe = load_recipe(meta["recipe"])
    runtime = load_runtime(recipe["runtime"])
    env = run_env(recipe, runtime, prefix)
    wine = str(runtime["root"] / runtime["wine"])
    appid = str(args.appid)
    if not (steam_root(prefix) / "steam.exe").is_file():
        die(f"bottle '{args.bottle}' has no Steam installation")
    ensure_steam_wrapper(prefix)
    log = Path(tempfile.gettempdir()) / f"mage-steam-install-{appid}.log"

    def start_client():
        lf = open(log, "w")
        subprocess.Popen([wine, STEAM_EXE] + STEAM_SILENT_ARGS,
                         env=env, stdout=lf, stderr=subprocess.STDOUT,
                         start_new_session=True)
        deadline = time.time() + args.steam_timeout
        while time.time() < deadline:
            if steam_client_pid(recipe, runtime, prefix) != 0:
                return
            time.sleep(2)
        die(f"Steam did not start within {args.steam_timeout}s (log: {log})")

    started_here = False
    restarted = False
    if steam_client_pid(recipe, runtime, prefix) == 0:
        start_client()
        started_here = True

    # Login gate: until the client holds a real account session it silently
    # drops +app_install, so forwarding earlier is wasted work. A client
    # applying a self-update may exit and relaunch itself mid-wait; if the
    # pid vanishes without the client coming back, restart it once.
    deadline = time.time() + args.steam_timeout
    while not steam_logged_in(prefix):
        if time.time() >= deadline:
            die(f"Steam did not reach a logged-in session within "
                f"{args.steam_timeout}s (log: {log})")
        if steam_client_pid(recipe, runtime, prefix) == 0:
            if restarted:
                die("Steam client exited during login and did not come back")
            time.sleep(5)
            if steam_client_pid(recipe, runtime, prefix) == 0:
                print("mage: Steam client died during boot; restarting",
                      file=sys.stderr)
                start_client()
                restarted = True
                started_here = True
        time.sleep(2)

    # Forwarding: this second process hands +app_install to the running
    # client via Steam's own single-instance IPC, then exits. A fresh client
    # registers ActiveProcess before it is ready to accept forwarded
    # commands, so a hung forward is killed and retried (idempotent).
    # The registry pid also goes stale when a client was killed without
    # shutdown: if we did not start the client and the first forward hangs,
    # the "running" client is a ghost — start a real one and retry.
    # Finally, a client that is still logging in accepts the IPC and then
    # silently drops the command, so every forward must be confirmed by
    # visible download activity, not just a clean exit code.
    for attempt in range(1, args.forward_retries + 1):
        try:
            r = subprocess.run([wine, STEAM_EXE, "-silent", "+app_install", appid],
                               env=env, stdout=subprocess.PIPE, stderr=subprocess.STDOUT,
                               text=True, timeout=30)
        except subprocess.TimeoutExpired:
            print(f"mage: forward attempt {attempt} timed out; client not ready yet",
                  file=sys.stderr)
            if not started_here:
                print("mage: stale Steam registry pid; starting a fresh client",
                      file=sys.stderr)
                start_client()
                started_here = True
            time.sleep(5)
            continue
        if r.returncode != 0:
            die(f"forwarding +app_install {appid} failed ({r.returncode})")
        confirm_deadline = time.time() + 25
        while time.time() < confirm_deadline:
            snap = install_snapshot(prefix, appid)
            if snap["state_flags"] is not None or snap["bytes_downloaded"] > 0:
                break
            time.sleep(2)
        else:
            print(f"mage: client dropped +app_install (attempt {attempt}); "
                  "re-forwarding", file=sys.stderr)
            continue
        break
    else:
        die("Steam client never acted on +app_install")

    if args.no_wait:
        print(json.dumps(install_snapshot(prefix, appid)))
        return
    deadline = time.time() + args.wait
    while True:
        snap = install_snapshot(prefix, appid)
        print(json.dumps(snap), flush=True)
        if snap["installed"]:
            return
        if time.time() >= deadline:
            snap["status"] = "timeout"
            print(json.dumps(snap))
            sys.exit(2)
        time.sleep(3)


def prefix_processes(prefix):
    """Pids of processes pinned to this prefix, two ways:
    (a) ps eww lines carrying the exact WINEPREFIX value — catches wineserver
        and wrapper processes. Wine PE processes clobber their argv/environ
        on macOS, so ps shows nothing of their env;
    (b) wine-looking processes (command contains 'wine' or '.exe') holding an
        open file under the prefix — catches detached PE survivors (crash
        handlers, helpers that lost their server).
    Scoping is exact: the WINEPREFIX value must be followed by whitespace/EOL
    (so bottles/steam does not match bottles/steam2), and open files must be
    strictly under <prefix>/. Other bottles and unrelated apps never match."""
    p = str(prefix)
    needle = re.compile(re.escape(f"WINEPREFIX={p}") + r"(\s|$)")
    me, parent = os.getpid(), os.getppid()
    r = subprocess.run(["/bin/ps", "axwwweo", "pid,command"],
                       stdout=subprocess.PIPE, stderr=subprocess.DEVNULL, text=True)
    pids = set()
    wineish = {}
    for line in r.stdout.splitlines():
        fields = line.split(None, 1)
        if len(fields) != 2:
            continue
        try:
            pid = int(fields[0])
        except ValueError:
            continue
        if pid in (me, parent):
            continue
        cmd = fields[1]
        if "wine" in cmd.lower() or ".exe" in cmd.lower():
            wineish[pid] = cmd
        if needle.search(cmd):
            pids.add(pid)
    # (b) open-file probe, only for wine-looking candidates not already found
    rest = [pid for pid in wineish if pid not in pids]
    if rest:
        r = subprocess.run(["/usr/sbin/lsof", "-a", "-Fn", "-p",
                            ",".join(str(p) for p in rest)],
                           stdout=subprocess.PIPE, stderr=subprocess.DEVNULL, text=True)
        cur = None
        for line in r.stdout.splitlines():
            if line.startswith("p"):
                try:
                    cur = int(line[1:])
                except ValueError:
                    cur = None
            elif line.startswith("n") and cur is not None:
                path = line[1:]
                if path == p or path.startswith(p + "/"):
                    pids.add(cur)
    return sorted((pid, wineish.get(pid, "")) for pid in pids)


def cmd_stop(args):
    """Stop everything running in a bottle's prefix (game, launchers, Steam)."""
    meta, prefix = find_bottle(args.name)
    recipe = load_recipe(meta["recipe"])
    runtime = load_runtime(recipe["runtime"])
    env = run_env(recipe, runtime, prefix)
    rel = runtime.get("wineserver") or str(Path(runtime["wine"]).parent / "wineserver")
    server = runtime["root"] / rel
    if not server.exists():
        die(f"runtime {recipe['runtime']}: {server} does not exist")
    r = subprocess.run([str(server), "-k"], env=env)
    # wineserver -k ends the session, but detached processes (crash handlers,
    # helpers that lost their server) can survive it. Sweep whatever still
    # carries this prefix's WINEPREFIX: SIGTERM, up to 3s grace, then SIGKILL.
    survivors = prefix_processes(prefix)
    had_survivors = bool(survivors)
    if survivors:
        print(f"mage: reaping {len(survivors)} leftover process(es) in prefix:")
        for pid, cmd in survivors:
            print(f"  term {pid}  {cmd[:100]}")
        for pid, _ in survivors:
            try:
                os.kill(pid, signal.SIGTERM)
            except OSError:
                pass
        deadline = time.time() + 3
        while time.time() < deadline and survivors:
            time.sleep(0.25)
            survivors = prefix_processes(prefix)
        if survivors:
            for pid, cmd in survivors:
                print(f"  kill {pid}  {cmd[:100]}")
                try:
                    os.kill(pid, signal.SIGKILL)
                except OSError:
                    pass
            time.sleep(0.5)
            survivors = prefix_processes(prefix)
            if survivors:
                print("mage: warning: process(es) survived SIGKILL: "
                      + ", ".join(str(p) for p, _ in survivors), file=sys.stderr)
    if r.returncode and not had_survivors:
        # wineserver -k exits non-zero when no session is alive for the
        # prefix — stopping a stopped bottle is a no-op, not an error.
        print(f"mage: nothing running for '{args.name}'")
        return
    print(f"mage: stopped '{args.name}'")


def cmd_doctor(args):
    meta, prefix = find_bottle(args.name)
    recipe = load_recipe(meta["recipe"])
    runtime = load_runtime(recipe["runtime"])
    DIAG_DIR.mkdir(parents=True, exist_ok=True)
    ts = time.strftime("%Y%m%d-%H%M%S")
    out = DIAG_DIR / f"{args.name}-{ts}.tgz"
    log = Path(tempfile.gettempdir()) / f"mage-{args.name}.log"
    with tempfile.TemporaryDirectory() as td:
        d = Path(td)
        (d / "recipe.json").write_text(json.dumps(recipe, indent=2))
        rt = dict(runtime)
        rt["root"] = str(rt["root"])
        (d / "runtime.json").write_text(json.dumps(rt, indent=2))
        (d / "bottle.json").write_text(json.dumps(meta, indent=2, default=str))
        (d / "env.txt").write_text("\n".join(
            f"{k}={v}" for k, v in sorted(run_env(recipe, runtime, prefix).items())
            if k.startswith(("WINE", "ROSETTA", "MTL", "MVK", "DYLD"))))
        subprocess.run(["sw_vers"], stdout=open(d / "sw_vers.txt", "w"))
        subprocess.run([str(runtime["root"] / runtime["wine"]), "--version"],
                       stdout=open(d / "wine-version.txt", "w"),
                       env=run_env(recipe, runtime, prefix))
        warns = file_checks(recipe, prefix)
        (d / "file-checks.txt").write_text("\n".join(warns) if warns else "all ok\n")
        if log.exists():
            (d / "last-log-tail.txt").write_text(
                "".join(open(log, errors="replace").readlines()[-500:]))
        with tarfile.open(out, "w:gz") as tar:
            tar.add(d, arcname=f"{args.name}-{ts}")
    print(f"mage: diagnostics → {out}")


def main():
    p = argparse.ArgumentParser(prog="mage", description=__doc__)
    sub = p.add_subparsers(dest="cmd", required=True)
    sub.add_parser("list").set_defaults(fn=cmd_list)
    pi = sub.add_parser("install")
    pi.add_argument("recipe")
    pi.add_argument("--name")
    pi.add_argument("--import-prefix")
    pi.set_defaults(fn=cmd_install)
    pr = sub.add_parser("run")
    pr.add_argument("name")
    pr.add_argument("--dry-run", action="store_true")
    pr.set_defaults(fn=cmd_run)
    pk = sub.add_parser("stop", help="kill every Wine process in a bottle's prefix")
    pk.add_argument("name")
    pk.set_defaults(fn=cmd_stop)
    pd = sub.add_parser("doctor")
    pd.add_argument("name")
    pd.set_defaults(fn=cmd_doctor)
    pw = sub.add_parser("steam-wrapper",
                        help="ensure the single-process steamwebhelper wrapper in a prefix")
    pw.add_argument("prefix")
    pw.set_defaults(fn=lambda a: ensure_steam_wrapper(Path(a.prefix)))
    ps = sub.add_parser("steam-install",
                        help="install an owned game via a -silent Steam client (+app_install)")
    ps.add_argument("bottle", help="bottle whose prefix has Steam (see: mage list)")
    ps.add_argument("appid", type=int)
    ps.add_argument("--wait", type=int, default=1800,
                    help="max seconds to poll for install completion (default 1800)")
    ps.add_argument("--no-wait", action="store_true",
                    help="forward the install command and print one status snapshot")
    ps.add_argument("--steam-timeout", type=int, default=120,
                    help="max seconds to wait for the silent Steam client to come up")
    ps.add_argument("--forward-retries", type=int, default=6,
                    help="attempts to forward +app_install while the client warms up")
    ps.set_defaults(fn=cmd_steam_install)
    args = p.parse_args()
    args.fn(args)


if __name__ == "__main__":
    main()
