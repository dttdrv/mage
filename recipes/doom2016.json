      "path": "drive_c/Program Files (x86)/Steam/steamapps/common/DOOM/CChromaEditorLibrary.dll.bak"
    }
  ],
  "id": "doom2016",
  "launch": [
    {
      "args": [
        "-silent",
        "-offline",
        "-noverifyfiles",
        "-nobootstrapupdate",
        "-skipinitialbootstrap",
        "-cef-disable-sandbox",
        "-cef-disable-gpu",
        "-cef-disable-gpu-compositing"
