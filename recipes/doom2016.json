      "background": true,
      "program": "C:\\Program Files (x86)\\Steam\\steam.exe",
      "then_wait": 20
    },
    {
      "args": [
        "-applaunch",
        "379720",
        "+com_SkipIntroVideo",
        "1",
        "+r_renderAPI",
        "1"
      ],
      "background": true,
      "program": "C:\\Program Files (x86)\\Steam\\steam.exe"
    }
  ],
  "runtime": "mage-wine-11.13",
  "steam_appid": "379720",
  "title": "DOOM (2016)"
}